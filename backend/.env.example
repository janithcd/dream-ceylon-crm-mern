# Dream Ceylon CRM - Backend Environment
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/dream-ceylon-crm?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Password reset delivery: Zoho CPaaS (formerly ZeptoMail), not Zoho Mail SMTP.
# Create a transactional email Agent and verify the sending domain first.
ZOHO_CPaaS_API_KEY=
ZOHO_CPaaS_FROM=admin@dreamceylonjourneys.com
# Use the endpoint shown in the Agent for your Zoho data center.
ZOHO_CPaaS_API_URL=https://cpaas.zoho.com/v1.1/email

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.2

CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=30
PUBLIC_INQUIRY_RATE_LIMIT_MAX=5

APP_NAME=Dream Ceylon CRM
APP_VERSION=1.0.0
